# ==================== УРОВЕНЬ 1: КОСМОБОЙ ====================
class SpaceShip:
    def __init__(self):
        self.w, self.h = 40, 40
        self.x, self.y = WIDTH // 2 - 20, HEIGHT - 80
        self.speed = 6; self.hp = 5; self.max_hp = 5; self.shoot_cd = 0; self.invuln = 0
    def update(self, keys):
        if keys[pygame.K_a] or keys[pygame.K_LEFT]: self.x -= self.speed
        if keys[pygame.K_d] or keys[pygame.K_RIGHT]: self.x += self.speed
        self.x = max(0, min(WIDTH - self.w, self.x))
        if self.shoot_cd > 0: self.shoot_cd -= 1
        if self.invuln > 0: self.invuln -= 1
    def draw(self, surf):
        if self.invuln > 0 and (self.invuln // 4) % 2 == 0: return
        cx = self.x + 20
        pygame.draw.polygon(surf, CYAN, [(cx, self.y), (self.x, self.y + 40), (self.x + 40, self.y + 40)])
        pygame.draw.rect(surf, BLUE, (self.x + 10, self.y + 32, 20, 8))

class Bullet:
    def __init__(self, x, y, vy, color, size=6, owner="player"):
        self.x, self.y, self.vy, self.color, self.size, self.owner = x, y, vy, color, size, owner
    def update(self): self.y += self.vy
    def draw(self, surf): pygame.draw.rect(surf, self.color, (self.x, self.y, self.size, self.size * 2))
    def off_screen(self): return self.y < -20 or self.y > HEIGHT + 20

class SlowEnemy:
    def __init__(self, x, y):
        self.w, self.h = 40, 30
        self.x, self.y = x, y
        self.hp = 2
        self.speed_x = random.choice([-1.5, 1.5])
        self.speed_y = random.choice([-0.5, 0.5, 1])
        self.color = random.choice([GREEN, PURPLE, ORANGE])
        self.shoot_timer = random.randint(90, 180)
    def update(self):
        self.x += self.speed_x
        self.y += self.speed_y
        if self.x < 0 or self.x > WIDTH - self.w: self.speed_x *= -1
        if self.y < 60 or self.y > HEIGHT // 2: self.speed_y *= -1
        if self.shoot_timer > 0: self.shoot_timer -= 1
    def draw(self, surf):
        x, y = self.x, self.y
        pygame.draw.rect(surf, self.color, (x + 6, y, 28, 30))
        pygame.draw.rect(surf, self.color, (x, y + 6, 40, 18))
        pygame.draw.rect(surf, BLACK, (x + 10, y + 10, 6, 6))
        pygame.draw.rect(surf, BLACK, (x + 24, y + 10, 6, 6))

class SpaceBoss:
    def __init__(self):
        self.w, self.h = 160, 110
        self.x, self.y = WIDTH // 2 - 80, -150
        self.target_y = 80; self.hp = 60; self.max_hp = 60
        self.time = 0; self.shoot_timer = 60
        self.laser_warning = 0
        self.laser_active = 0
        self.laser_x = WIDTH // 2
    def update(self):
        self.time += 0.03
        if self.y < self.target_y: self.y += 2
        self.x = WIDTH // 2 - 80 + math.sin(self.time) * 120
        
        if self.laser_warning > 0:
            self.laser_warning -= 1
            if self.laser_warning == 0:
                self.laser_active = 30
        elif self.laser_active > 0:
            self.laser_active -= 1
        else:
            if random.random() < 0.01:
                self.laser_warning = 60
                self.laser_x = self.x + 80 # Центр босса

    def draw(self, surf):
        x, y = self.x, self.y
        pygame.draw.ellipse(surf, PURPLE, (x, y + 20, 160, 90))
        pygame.draw.ellipse(surf, (100, 0, 150), (x + 30, y, 100, 110))
        pygame.draw.circle(surf, CYAN, (int(x + 80), int(y + 40)), 25)
        for i in range(4):
            pygame.draw.circle(surf, RED, (int(x + 25 + i * 35), int(y + 70)), 8)
            
        # Лазер из тарелки
        if self.laser_warning > 0:
            # Красный треугольник предупреждения под боссом
            pygame.draw.polygon(surf, RED, [
                (self.laser_x - 20, y + self.h),
                (self.laser_x + 20, y + self.h),
                (self.laser_x, y + self.h + 40)
            ])
        elif self.laser_active > 0:
            # Белая трассировка из тарелки
            pygame.draw.line(surf, WHITE, (self.laser_x, y + self.h), (self.laser_x, HEIGHT), 15)
            pygame.draw.line(surf, CYAN, (self.laser_x, y + self.h), (self.laser_x, HEIGHT), 5)

def draw_space_bg(surf):
    surf.fill(DARK)
    pygame.draw.circle(surf, EARTH_BLUE, (-100, HEIGHT + 150), 250)
    pygame.draw.circle(surf, (0, 150, 0), (-120, HEIGHT + 180), 80)
    pygame.draw.circle(surf, MOON_GRAY, (WIDTH + 50, -50), 80)
    pygame.draw.circle(surf, (120, 120, 120), (WIDTH + 70, -30), 15)

def play_space_level():
    smooth_fade_in(game_surface)
    player = SpaceShip()
    bullets, enemy_bullets, enemies = [], [], []
    boss = None
    killed = 0
    misses = 0
    enemies_to_kill = 5
    
    max_ammo = 10
    ammo = max_ammo
    is_reloading = False
    reload_timer = 0
    reload_max = FPS * 3
    
    for i in range(enemies_to_kill):
        enemies.append(SlowEnemy(80 + i * 130, 100 + (i%2)*50))

    running = True
    while running:
        clock.tick(FPS)
        for e in pygame.event.get():
            if e.type == pygame.QUIT: pygame.quit(); sys.exit()
            if e.type == pygame.KEYDOWN:
                if e.key == pygame.K_RETURN:
                    if pause_menu() == "menu": return "menu", False
                if e.key == pygame.K_SPACE and player.shoot_cd <= 0 and ammo > 0 and not is_reloading:
                    bullets.append(Bullet(player.x + 18, player.y, -10, YELLOW))
                    player.shoot_cd = 10
                    if sound_laser:
                        sound_laser.play()
                    ammo -= 1
                    if ammo == 0:
                        is_reloading = True
                        reload_timer = reload_max

        if is_reloading:
            reload_timer -= 1
            if reload_timer <= 0:
                ammo = max_ammo
                is_reloading = False

        keys = pygame.key.get_pressed()
        player.update(keys)

        for b in bullets[:]:
            b.update()
            if b.off_screen(): 
                bullets.remove(b)
                misses += 1
            else:
                for en in enemies[:]:
                    if en.x < b.x < en.x + en.w and en.y < b.y < en.y + en.h:
                        bullets.remove(b); en.hp -= 1
                        if en.hp <= 0: enemies.remove(en); killed += 1
                        break

        if killed >= enemies_to_kill and not boss:
            boss = SpaceBoss()
            enemy_bullets.clear()

        if boss:
            boss.update()
            
            if boss.laser_active > 0:
                if abs(player.x + 20 - boss.laser_x) < 30:
                    player.hp -= 5
                    
            if boss.shoot_timer > 0: boss.shoot_timer -= 1
            else:
                boss.shoot_timer = 60
                enemy_bullets.append(Bullet(boss.x + 40, boss.y + 90, 6, RED, 8))
                enemy_bullets.append(Bullet(boss.x + 120, boss.y + 90, 6, RED, 8))

            for b in bullets[:]:
                if boss.x < b.x < boss.x + boss.w and boss.y < b.y < boss.y + boss.h:
                    bullets.remove(b); boss.hp -= 1
                    if boss.hp <= 0: 
                        perfect = (misses == 0)
                        return "victory", perfect

        for en in enemies:
            en.update()
            if en.shoot_timer <= 0:
                enemy_bullets.append(Bullet(en.x + 18, en.y + 30, 5, RED, 6))
                en.shoot_timer = random.randint(100, 180)

        for b in enemy_bullets[:]:
            b.update()
            if b.off_screen(): enemy_bullets.remove(b)
            elif player.invuln <= 0 and player.x < b.x < player.x + player.w and player.y < b.y < player.y + player.h:
                enemy_bullets.remove(b)
                player.hp -= 1; player.invuln = 60
                if player.hp <= 0: return "gameover", False

        draw_space_bg(game_surface)
        for en in enemies: en.draw(game_surface)
        for b in bullets: b.draw(game_surface)
        for b in enemy_bullets: b.draw(game_surface)
        if boss: 
            boss.draw(game_surface)
            draw_hp_bar(game_surface, WIDTH - 210, 40, boss.hp, boss.max_hp, RED)
        player.draw(game_surface)
        draw_hp_bar(game_surface, 10, 40, player.hp, player.max_hp, GREEN)
        
        if is_reloading:
            rt = font_small.render(f"ПЕРЕЗАРЯДКА: {reload_timer/FPS:.1f}с", True, RED)
            game_surface.blit(rt, (WIDTH - 200, 10))
        else:
            at = font_small.render(f"Патроны: {ammo}/{max_ammo}", True, YELLOW)
            game_surface.blit(at, (WIDTH - 150, 10))

        draw_fps(game_surface)
        
        scaled = pygame.transform.scale(game_surface, (SCREEN_W, SCREEN_H))
        screen.blit(scaled, (0, 0))
        pygame.display.flip()

# ==================== УРОВЕНЬ 2: НАЙДИ ПРИШЕЛЬЦА ====================
class Hero:
    def __init__(self):
        self.w, self.h = 30, 40
        self.x, self.y = 100, 100
        self.speed = 5

    def update(self, keys):
        if keys[pygame.K_a] or keys[pygame.K_LEFT]: self.x -= self.speed
        if keys[pygame.K_d] or keys[pygame.K_RIGHT]: self.x += self.speed
        if keys[pygame.K_w] or keys[pygame.K_UP]: self.y -= self.speed
        if keys[pygame.K_s] or keys[pygame.K_DOWN]: self.y += self.speed

    def draw(self, surf, cam_x, cam_y):
        px, py = self.x - cam_x, self.y - cam_y
        pygame.draw.rect(surf, (255, 200, 150), (px + 5, py, 20, 15))
        pygame.draw.rect(surf, BLUE, (px, py + 15, 30, 25))
        pygame.draw.rect(surf, BLACK, (px + 10, py + 35, 10, 5))
        
        mx, my = pygame.mouse.get_pos()
        mx = mx * (WIDTH / SCREEN_W)
        my = my * (HEIGHT / SCREEN_H)
        
        angle = math.atan2(my - (py + 20), mx - (px + 15))
        pygame.draw.line(surf, GRAY, (px + 15, py + 20), (px + 15 + math.cos(angle)*20, py + 20 + math.sin(angle)*20), 5)

class RunningAlien:
    def __init__(self, x, y):
        self.x, self.y = x, y
        self.w, self.h = 40, 30
        self.alive = True
        self.color = random.choice([RED, BLACK])
        self.speed_x = random.choice([-1, 1]) * random.uniform(1, 3)
        self.speed_y = random.choice([-1, 1]) * random.uniform(1, 3)
        self.base_x = x
        self.base_y = y
        self.time = random.uniform(0, 6)

    def update(self, hero_x, hero_y):
        # Убегаем от игрока
        dx = self.x - hero_x
        dy = self.y - hero_y
        dist = math.hypot(dx, dy)
        if dist < 200 and dist > 0:
            self.x += (dx / dist) * 2
            self.y += (dy / dist) * 2
        
        # Слегка болтаемся для анимации
        self.time += 0.1
        self.x += math.sin(self.time) * 0.5
        self.y += math.cos(self.time) * 0.5

    def draw(self, surf, cam_x, cam_y):
        if not self.alive: return
        px, py = self.x - cam_x, self.y - cam_y
        # Рисуем как в 1-й игре
        pygame.draw.rect(surf, self.color, (px + 6, py, 28, 30))
        pygame.draw.rect(surf, self.color, (px, py + 6, 40, 18))
        pygame.draw.rect(surf, BLACK, (px + 10, py + 10, 6, 6))
        pygame.draw.rect(surf, BLACK, (px + 24, py + 10, 6, 6))

def play_find_alien_level():
    smooth_fade_in(game_surface)
    hero = Hero()
    aliens = []
    killed = 0
    world_w, world_h = 2000, 1500
    cam_x, cam_y = 0, 0
    bullets = []
    
    max_ammo = 8
    ammo = max_ammo
    is_reloading = False
    reload_timer = 0
    
    for i in range(20):
        x = random.randint(100, world_w - 100)
        y = random.randint(100, world_h - 100)
        aliens.append(RunningAlien(x, y))

    running = True
    while running:
        clock.tick(FPS)
        for e in pygame.event.get():
            if e.type == pygame.QUIT: pygame.quit(); sys.exit()
            if e.type == pygame.KEYDOWN:
                if e.key == pygame.K_RETURN:
                    if pause_menu() == "menu": return "menu"
            
            # СТРЕЛЬБА МЫШКОЙ
            if e.type == pygame.MOUSEBUTTONDOWN and e.button == 1 and ammo > 0 and not is_reloading:
                mx, my = pygame.mouse.get_pos()
                mx = mx * (WIDTH / SCREEN_W)
                my = my * (HEIGHT / SCREEN_H)
                
                angle = math.atan2(my + cam_y - (hero.y + 20), mx + cam_x - (hero.x + 15))
                bullets.append([hero.x + 15, hero.y + 20, math.cos(angle)*15, math.sin(angle)*15])
                
                if sound_pistol:
                    sound_pistol.play()
                    
                ammo -= 1
                if ammo == 0:
                    is_reloading = True
                    reload_timer = FPS * 5

        if is_reloading:
            reload_timer -= 1
            if reload_timer <= 0:
                ammo = max_ammo
                is_reloading = False

        keys = pygame.key.get_pressed()
        hero.update(keys)
        cam_x = max(0, min(world_w - WIDTH, hero.x - WIDTH // 2))
        cam_y = max(0, min(world_h - HEIGHT, hero.y - HEIGHT // 2))

        for b in bullets[:]:
            b[0] += b[2]
            b[1] += b[3]
            if b[0] < 0 or b[0] > world_w or b[1] < 0 or b[1] > world_h: 
                bullets.remove(b)
            else:
                for al in aliens:
                    if al.alive and al.x < b[0] < al.x + al.w and al.y < b[1] < al.y + al.h:
                        al.alive = False
                        killed += 1
                        bullets.remove(b)
                        break

        # Обновляем убегающих пришельцев
        for al in aliens:
            if al.alive:
                al.update(hero.x, hero.y)

        game_surface.fill((100, 160, 100))
        for rx in range(0, world_w, 400): pygame.draw.rect(game_surface, GRAY, (rx - cam_x, 0, 100, HEIGHT))
        for ry in range(0, world_h, 400): pygame.draw.rect(game_surface, GRAY, (0, ry - cam_y, WIDTH, 100))

        for al in aliens: al.draw(game_surface, cam_x, cam_y)
        
        for b in bullets: 
            pygame.draw.circle(game_surface, YELLOW, (int(b[0] - cam_x), int(b[1] - cam_y)), 5)
            pygame.draw.circle(game_surface, ORANGE, (int(b[0] - cam_x), int(b[1] - cam_y)), 2)
            
        hero.draw(game_surface, cam_x, cam_y)
        
        draw_hp_bar(game_surface, 10, 40, 5, 5, GREEN)
        draw_text_center(game_surface, f"Найдено: {killed} / 20", font_small, BLACK, -HEIGHT//2 + 30)
        
        if is_reloading:
            rt = font_small.render(f"ПЕРЕЗАРЯДКА: {reload_timer/FPS:.1f}с", True, RED)
            game_surface.blit(rt, (WIDTH - 200, 10))
        else:
            at = font_small.render(f"Патроны: {ammo}/{max_ammo}", True, BLACK)
            game_surface.blit(at, (WIDTH - 150, 10))

        draw_fps(game_surface)
        
        scaled = pygame.transform.scale(game_surface, (SCREEN_W, SCREEN_H))
        screen.blit(scaled, (0, 0))
        pygame.display.flip()
        
        if killed >= 20: return "victory"

# ==================== УРОВЕНЬ 3: КОСМОЗМЕЙКА ====================
class CosmoSnake:
    def __init__(self):
        self.cell_size = 25
        self.cols = WIDTH // self.cell_size
        self.rows = HEIGHT // self.cell_size
        self.snake = [(self.cols // 2, self.rows // 2)]
        self.direction = (1, 0)
        self.new_direction = (1, 0)
        self.food = self.spawn_food()
        self.score = 0
        self.move_timer = 0
        self.move_delay = 10
        self.game_over = False

    def spawn_food(self):
        while True:
            pos = (random.randint(0, self.cols - 1), random.randint(0, self.rows - 1))
            if pos not in self.snake:
                return pos

    def update(self):
        if self.game_over: return
        self.move_timer += 1
        if self.move_timer < self.move_delay: return
        self.move_timer = 0

        self.direction = self.new_direction
        head_x, head_y = self.snake[0]
        new_head = (head_x + self.direction[0], head_y + self.direction[1])

        if new_head[0] < 0 or new_head[0] >= self.cols or new_head[1] < 0 or new_head[1] >= self.rows:
            self.game_over = True
            return

        if new_head in self.snake:
            self.game_over = True
            return

        self.snake.insert(0, new_head)

        if new_head == self.food:
            self.score += 1
            self.food = self.spawn_food()
        else:
            self.snake.pop()

    def draw(self, surf):
        surf.fill(DARK)
        
        fx = self.food[0] * self.cell_size
        fy = self.food[1] * self.cell_size
        pygame.draw.rect(surf, CYAN, (fx + 2, fy + 2, self.cell_size - 4, self.cell_size - 4))
        pygame.draw.rect(surf, WHITE, (fx + 8, fy + 8, self.cell_size - 16, self.cell_size - 16))

        for i, (x, y) in enumerate(self.snake):
            px = x * self.cell_size
            py = y * self.cell_size
            color = GREEN if i == 0 else (0, 200, 0)
            pygame.draw.rect(surf, color, (px + 1, py + 1, self.cell_size - 2, self.cell_size - 2))
            if i == 0:
                pygame.draw.rect(surf, BLACK, (px + 6, py + 6, 4, 4))
                pygame.draw.rect(surf, BLACK, (px + 15, py + 6, 4, 4))

        draw_text_center(surf, "КОСМОЗМЕЙКА", font_big, CYAN, -HEIGHT // 2 + 30)
        draw_text_center(surf, f"Очки: {self.score} / 15", font_mid, YELLOW, -HEIGHT // 2 + 80)
        
        if self.game_over:
            overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
            overlay.fill((0, 0, 0, 200))
            surf.blit(overlay, (0, 0))
            draw_text_center(surf, "GAME OVER", font_big, RED, -50)
            draw_text_center(surf, "ENTER - в меню", font_mid, WHITE, 50)

def play_snake_level():
    smooth_fade_in(game_surface)
    game = CosmoSnake()
    
    running = True
    while running:
        clock.tick(FPS)
        for e in pygame.event.get():
            if e.type == pygame.QUIT: pygame.quit(); sys.exit()
            if e.type == pygame.KEYDOWN:
                if e.key == pygame.K_RETURN:
                    if game.game_over: return "gameover"
                    if pause_menu() == "menu": return "menu"
                if not game.game_over:
                    if (e.key == pygame.K_w or e.key == pygame.K_UP) and game.direction != (0, 1):
                        game.new_direction = (0, -1)
                    elif (e.key == pygame.K_s or e.key == pygame.K_DOWN) and game.direction != (0, -1):
                        game.new_direction = (0, 1)
                    elif (e.key == pygame.K_a or e.key == pygame.K_LEFT) and game.direction != (1, 0):
                        game.new_direction = (-1, 0)
                    elif (e.key == pygame.K_d or e.key == pygame.K_RIGHT) and game.direction != (-1, 0):
                        game.new_direction = (1, 0)

        if not game.game_over:
            game.update()

        game.draw(game_surface)
        draw_fps(game_surface)
        
        scaled = pygame.transform.scale(game_surface, (SCREEN_W, SCREEN_H))
        screen.blit(scaled, (0, 0))
        pygame.display.flip()
        
        if game.score >= 15: return "victory"

